# FundLink Production Environment Template
# Copy this file to .env.production and fill in your values

# Database Configuration
POSTGRES_DB=fundlink_prod
POSTGRES_USER=fundlink_prod  
POSTGRES_PASSWORD=your-super-secure-database-password-change-this

# Django Configuration
SECRET_KEY=your-django-secret-key-generate-with-python-secrets
DEBUG=false
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,*.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Internal Service Authentication
INTERNAL_API_KEY=your-secure-internal-api-key-for-services

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/bot/api/webhook/telegram/
PUBLIC_WEBHOOK_BASE=https://yourdomain.com
TELEGRAM_WEBHOOK_SECRET=optional-webhook-security-token

# LLM Configuration (Together.ai)
TOGETHER_API_KEY=your-together-ai-api-key
TOGETHER_MODEL=meta-llama/Llama-3.1-8B-Instruct
TOGETHER_MODEL_FALLBACK=meta-llama/Llama-3.1-8B-Instruct
LLM_TEMPERATURE=0.2
HTTP_TIMEOUT=20

# Avalanche Blockchain Configuration
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113
USDT_CONTRACT_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# Redis Configuration (optional)
REDIS_URL=redis://redis:6379/0

# Logging and Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-for-error-tracking
HEALTHCHECKS_PING_URL=your-healthchecks-io-url

# Docker Configuration
DOCKER_USERNAME=yourdockerhubusername
IMAGE_TAG=latest
DOMAIN=yourdomain.com

# Generation Commands:
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# Generate INTERNAL_API_KEY: python -c "import secrets; print('fundlink_' + secrets.token_urlsafe(32))"
# Generate TELEGRAM_WEBHOOK_SECRET: python -c "import secrets; print(secrets.token_urlsafe(16))"