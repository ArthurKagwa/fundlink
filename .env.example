# FundLink Unified Environment Variables

# Django / Core
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (SQLite default if omitted)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Avalanche / Web3
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113
USDT_CONTRACT_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Internal Service Auth
INTERNAL_API_KEY=your-shared-internal-key
# Legacy (optional) HMAC secret still supported for /api/bot/notify/
BOT_NOTIFY_SECRET=

# LLM / Together
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.1-70B-Instruct-Turbo
TOGETHER_MODEL_FALLBACK=meta-llama/Llama-3.1-8B-Instruct
LLM_TEMPERATURE=0.2
HTTP_TIMEOUT=20

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# Logging / Observability
LOG_LEVEL=INFO
SENTRY_DSN=
HEALTHCHECKS_PING_URL=

# Optional future additions
# FRONTEND_URL=
# ALLOWED_ORIGINS=
